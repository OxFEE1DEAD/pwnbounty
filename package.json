{
  "name": "sealed-bounty",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "node --import tsx --test verifier/test/*.test.ts",
    "cli": "node --import tsx verifier/src/cli.ts",
    "build:web": "tsc --noEmit -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "format": "prettier --write web/src web/vite.config.ts verifier protocol"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.11.4",
    "near-api-js": "^7.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
