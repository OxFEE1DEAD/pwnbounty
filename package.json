{
  "name": "sealed-bounty",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "node --import tsx --test verifier/test/*.test.ts",
    "cli": "node --import tsx verifier/src/cli.ts",
    "build:web": "tsc --noEmit -p web/tsconfig.json && esbuild web/src/app.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=web/dist/app.js && cp web/index.html web/style.css web/dist/"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.11.4",
    "near-api-js": "^7.4.0"
  }
}
